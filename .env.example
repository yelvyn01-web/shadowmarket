# ==============================================================================
# SHADOWMARKET - PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Copy this file to .env.local and replace the placeholders with your actual keys.

# 1. Supabase PostgreSQL & Auth Credentials (Singapore sin1)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_here

# 2. Master AES-256-GCM Digital License Encryption Key (32-bytes Hex)
LICENSE_ENCRYPTION_KEY=your_32_byte_hex_encryption_key_here

# 3. Payment Gateway & Webhook Signature Secret
PAYMENT_SANDBOX_MODE=true
PAYMENT_WEBHOOK_SECRET=whsec_your_payment_webhook_secret_here
